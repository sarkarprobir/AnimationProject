        // ✅ add this once in your JS
        function debounce(fn, delay) {
            let timer;
            return function (...args) {
                const context = this;
                clearTimeout(timer);
                timer = setTimeout(() => fn.apply(context, args), delay);
            };
        }
                    function switchTab(tabElement, tabName, pageNo) {
          currentTabName = tabName;         // remember active tab
          const recordPerPage = 20;         // your page size
          if (!pageNo) {                    // tab changed / fresh load -> reset pager
            elPage = 1;
            elWindowStart = 1;
          }

          // Map tab -> CategoryId
          let Categoryvalue = 0;
          if (tabName === 'shapes')      Categoryvalue = 2;
          else if (tabName === 'icons')  Categoryvalue = 3;
          else if (tabName === 'photos') Categoryvalue = 1;
          else if (tabName === 'my-images') Categoryvalue = 5;
          else if (tabName === 'patterns')  Categoryvalue = 4;

          const dataSlide = {
            CategoryId: Number(Categoryvalue) || 0,
            searchKeyword: (Array.isArray($("#txtElementSearch").val())
              ? $("#txtElementSearch").val().join(" ")
              : String($("#txtElementSearch").val() ?? "")
            ).trim(),
            pageNo: pageNo || elPage || 1,
            recordPerPage: recordPerPage
          };

          $.ajax({
            url: baseURL + "Canvas/GetAllElement",
            type: "POST",
            dataType: "json",
            data: dataSlide,
            success: function (slideResult) {
              console.log("slideResult", slideResult);

              // choose container
              const targetIdMap = { 1: "#photoList", 2: "#shapesList", 3: "#iconList", 5: "#my-imagesList" };
              const catNum = Number(Categoryvalue);
              const $list = $(targetIdMap[catNum] || "#shapesList");
              if ($list.length === 0) { console.warn("Target list not found"); return; }

              // clear and render
              $list.empty();

              // items array normalize
              const items = Array.isArray(slideResult)
                ? slideResult
                : (slideResult.list || slideResult.items || slideResult.data || slideResult.elementList || []);

              // --- render thumbnails (your existing logic) ---
              const joinURL = (...parts) => parts
                .filter(Boolean)
                .map((p, i) => i === 0 ? String(p).replace(/\/+$/,'') : String(p).replace(/^\/+|\/+$/g,''))
                .join('/');

              const frag = document.createDocumentFragment();
              let appended = 0;

              (items || []).forEach(it => {
                const fileThumb = it.imageNameThumb || "";
                const fileFull  = it.imageNameThumb || fileThumb;
                if (!fileThumb) return;

                const srcThumb = joinURL(baseURL, elementPath, encodeURIComponent(fileThumb));
                const srcFull  = joinURL(baseURL, elementPath, encodeURIComponent(fileFull));

                const img = new Image();
                img.src = srcThumb;
                img.alt = it.elementName || "";
                img.loading = "lazy";
                img.className = "shape-thumb";
                img.dataset.elementId = it.elementId;
                img.dataset.categoryId = it.categoryId;
                img.dataset.full = srcFull;

                if (Number(it.imageW) > 0) img.width  = Number(it.imageW);
                if (Number(it.imageH) > 0) img.height = Number(it.imageH);

                frag.appendChild(img);
                appended++;
              });

              if (appended === 0) {
                $list.append('<div class="text-muted p-2">No elements found.</div>');
              } else {
                $list[0].appendChild(frag);
              }

              // --- compute total pages from server response ---
              // Prefer slideResult.totalPages; else compute from totalCount if provided
              if (slideResult && Number(slideResult.totalPages) > 0) {
                elTotalPages = Number(slideResult.totalPages);
              } else if (slideResult && Number(slideResult.totalCount) >= 0) {
                elTotalPages = Math.max(1, Math.ceil(Number(slideResult.totalCount) / recordPerPage));
              } else {
                // Fallback: if no totals provided, infer minimal
                elTotalPages = Math.max(elPage, (items && items.length === recordPerPage) ? elPage + 1 : elPage);
              }

              // update current page and re-render pager
