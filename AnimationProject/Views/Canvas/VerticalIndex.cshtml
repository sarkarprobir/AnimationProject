   <script>
               // Pager state
        const PAGE_WINDOW_SIZE = 6;
        let elPage = 1;             // current selected page
        let elTotalPages = 1;       // set from server
        let elWindowStart = 1;      // first visible page number in the window
        let currentTabName = 'shapes'; // track which tab is active

        function clampWindowStart() {
          const maxStart = Math.max(1, elTotalPages - PAGE_WINDOW_SIZE + 1);
          elWindowStart = Math.min(Math.max(1, elWindowStart), maxStart);
          // Ensure current page is visible
          if (elPage < elWindowStart) elWindowStart = elPage;
          const end = elWindowStart + PAGE_WINDOW_SIZE - 1;
          if (elPage > end) elWindowStart = Math.max(1, elPage - PAGE_WINDOW_SIZE + 1);
        }

        function renderPagination() {
          const $p = $('#elPagination');
          if (elTotalPages <= 1) { $p.empty().hide(); return; }
          $p.show();

          clampWindowStart();

          const frag = document.createDocumentFragment();

          // ‹ prev-window
          const prev = document.createElement('span');
          prev.textContent = '‹';
          prev.dataset.dir = 'prev';
          if (elWindowStart === 1) prev.classList.add('disabled');
          frag.appendChild(prev);

          // page numbers
          const end = Math.min(elWindowStart + PAGE_WINDOW_SIZE - 1, elTotalPages);
          for (let i = elWindowStart; i <= end; i++) {
            const s = document.createElement('span');
            s.textContent = String(i);
            s.dataset.page = String(i);
            if (i === elPage) s.classList.add('active');
            frag.appendChild(s);
          }

          // › next-window
          const next = document.createElement('span');
          next.textContent = '›';
          next.dataset.dir = 'next';
          if (end === elTotalPages) next.classList.add('disabled');
          frag.appendChild(next);

          $p.empty()[0].appendChild(frag);
        }

        // Handle clicks (delegated)
        $(document).on('click', '#elPagination span', function () {
          const dir = this.dataset.dir;
          if (dir === 'prev') {
            if (elWindowStart > 1) { elWindowStart--; renderPagination(); }
            return;
          }
          if (dir === 'next') {
            const maxStart = Math.max(1, elTotalPages - PAGE_WINDOW_SIZE + 1);
            if (elWindowStart < maxStart) { elWindowStart++; renderPagination(); }
            return;
          }

          const page = Number(this.dataset.page);
          if (!page || page === elPage) return;
          elPage = page;
          // reload with selected page
          switchTab(null, currentTabName, elPage);
        });
       
   </script>

    <script>
            (function(){
          const canvas    = document.getElementById('myCanvas');
          const container = document.getElementById('canvasContainer');
          const ctx       = canvas.getContext('2d');
          const dpr       = window.devicePixelRatio || 1;

          //──────────────────────────────────────────────────────────
          // STATE: these will be set dynamically on first resize
          let DESIGN_W, DESIGN_H;
          let scaleX = 1, scaleY = 1;
          let firstRun = true;
          //──────────────────────────────────────────────────────────

          function resizeCanvas() {
             // console.log("resizeCanvas");
            // 1) Figure out how big the canvas *looks* on the page (CSS px)
            const containerW = container.clientWidth;
            const cssW       = containerW * 0.34;          // e.g. 32% of container
            const cssH       = cssW * (16/9);              // your chosen aspect

            canvas.style.width  = cssW + 'px';
            canvas.style.height = cssH + 'px';

            // 2) Resize the internal buffer for HiDPI
            const bufW = Math.round(cssW * dpr);
            const bufH = Math.round(cssH * dpr);
            if (canvas.width !== bufW || canvas.height !== bufH) {
              canvas.width  = bufW;
              canvas.height = bufH;
            }

            // 3) Compute the *actual* drawing‐space size in CSS pixels
            const screenW = canvas.width  / dpr;
            const screenH = canvas.height / dpr;

            // 4) On very first run, “lock in” your design resolution
            if (firstRun) {
              DESIGN_W  = screenW;
              DESIGN_H  = screenH;
              firstRun  = false;
              console.log(`Captured design size: ${DESIGN_W}×${DESIGN_H}`);
            }

            // 5) Now compute how much to scale your design → screen
            scaleX = screenW / DESIGN_W;
            scaleY = screenH / DESIGN_H;

            // 6) Reset any old transforms, then apply:
            //   a) dpr for HiDPI (1 unit → 1 CSS px)
            //   b) design→screen scale
            ctx.resetTransform();
            ctx.scale(dpr, dpr);
            ctx.scale(scaleX, scaleY);
          }

          // expose & hook up
          window.resizeCanvas = resizeCanvas;
          window.addEventListener('resize',  resizeCanvas);
          window.addEventListener('DOMContentLoaded', resizeCanvas);
        })();
    </script>
