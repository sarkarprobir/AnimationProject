               $(document).on('input', '#txtElementSearch', debounce(function () {
          const val = this.value.trim();
          if (val.length >= 3 || val.length === 0) {
            const activeId = document.querySelector('.left_content.active')?.id || '';
            switchTab(null, activeId); // keep current tab explicitly
          }
        }, 150));

        // ✅ add this once in your JS
        function debounce(fn, delay) {
            let timer;
            return function (...args) {
                const context = this;
                clearTimeout(timer);
                timer = setTimeout(() => fn.apply(context, args), delay);
            };
        }
                function switchTab(tabElement, tabName, pageNo) {
          currentTabName = tabName;
          const recordPerPage = 20;

          if (!pageNo) { elPage = 1; elWindowStart = 1; }

          // Map tab -> CategoryId
          let Categoryvalue = 0;
          if (tabName === 'shapes')      Categoryvalue = 2;
          else if (tabName === 'icons')  Categoryvalue = 3;
          else if (tabName === 'photos') Categoryvalue = 1;
          else if (tabName === 'my-images') Categoryvalue = 5;
          else if (tabName === 'patterns')  Categoryvalue = 4;

          const dataSlide = {
            CategoryId: Number(Categoryvalue) || 0,
            searchKeyword: (Array.isArray($("#txtElementSearch").val())
              ? $("#txtElementSearch").val().join(" ")
              : String($("#txtElementSearch").val() ?? "")
            ).trim(),
            pageNo: pageNo || elPage || 1,
            recordPerPage: recordPerPage
          };

          $.ajax({
            url: baseURL + "Canvas/GetAllElementNew",
            type: "POST",
            dataType: "json",
            data: dataSlide,
            success: function (slideResult) {
              // helper to read either camelCase or PascalCase
              const pick = (o, keys) => {
                for (const k of keys) if (o && o[k] !== undefined && o[k] !== null) return o[k];
                return undefined;
              };

              // choose container
              const targetIdMap = { 1: "#photoList", 2: "#shapesList", 3: "#iconList", 5: "#my-imagesList" };
              const catNum = Number(Categoryvalue);
              const $list = $(targetIdMap[catNum] || "#shapesList");
              if ($list.length === 0) { console.warn("Target list not found"); return; }

              // clear
              $list.empty();

              // normalize items (supports: array | {items|Items|list|data|elementList})
              let items = Array.isArray(slideResult)
                ? slideResult
                : (pick(slideResult, ["items","Items","list","data","elementList"]) || []);

              // --- render thumbnails ---
              const joinURL = (...parts) => parts
                .filter(Boolean)
                .map((p, i) => i === 0 ? String(p).replace(/\/+$/,'') : String(p).replace(/^\/+|\/+$/g,''))
                .join('/');

              const frag = document.createDocumentFragment();
              let appended = 0;

              (items || []).forEach(it => {
                const fileThumb = it.imageNameThumb || it.ImageNameThumb || "";
                const fileFull  = it.imageName || it.ImageName || fileThumb;
                if (!fileThumb) return;

                const srcThumb = joinURL(baseURL, elementPath, encodeURIComponent(fileThumb));
                const srcFull  = joinURL(baseURL, elementPath, encodeURIComponent(fileFull));

                const img = new Image();
                img.src = srcThumb;
                img.alt = it.elementName || it.ElementName || "";
                img.loading = "lazy";
                img.className = "shape-thumb";
                img.dataset.elementId = it.elementId ?? it.ElementId;
                img.dataset.categoryId = it.categoryId ?? it.CategoryId;
                img.dataset.full = srcFull;

                const w = Number(it.imageW ?? it.ImageW);
                const h = Number(it.imageH ?? it.ImageH);
                if (w > 0) img.width  = w;
                if (h > 0) img.height = h;

                frag.appendChild(img);
                appended++;
              });

              if (appended === 0) {
                $list.append('<div class="text-muted p-2">No elements found.</div>');
              } else {
                $list[0].appendChild(frag);
              }

              // --- totals / paging fields (supports camelCase or PascalCase) ---
              const respTotalPages = Number(pick(slideResult, ["totalPages","TotalPages"]));
              const respTotalCount = Number(pick(slideResult, ["totalCount","TotalCount"]));
              const respPageNo     = Number(pick(slideResult, ["pageNo","PageNo"]));
              const respPageSize   = Number(pick(slideResult, ["pageSize","PageSize"]));

              if (respTotalPages > 0) {
                elTotalPages = respTotalPages;
              } else if (!isNaN(respTotalCount)) {
                const size = respPageSize > 0 ? respPageSize : recordPerPage;
                elTotalPages = Math.max(1, Math.ceil(respTotalCount / size));
              } else {
                // fallback if API doesn't send totals
                elTotalPages = Math.max(elPage, (items && items.length === recordPerPage) ? elPage + 1 : elPage);
              }

              // keep selected page (prefer server echo if present)
              elPage = respPageNo > 0 ? respPageNo : dataSlide.pageNo;

              // make sure current page is visible and re-render pager
              ensurePageVisible(elPage);
