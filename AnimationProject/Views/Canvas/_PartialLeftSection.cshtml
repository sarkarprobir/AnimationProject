</script> *@




<div class="panel-left-scroll">
    <button onclick="tranTogglePopup(); transitionSelected(this);" class="sd-btn-right mb-3"> <img src="~/images/icon-01.png" alt="Banner" style="width: 19px;">Transition</button>
    <input type="hidden" id="hdnSlideSequence1" value=1 />
    <input type="hidden" id="hdnSlideSequence2" value=2 />
    <input type="hidden" id="hdnSlideSequence3" value=3 />
    <input type="hidden" id="hdnSlideName1" value="Slide-1" />
    <input type="hidden" id="hdnSlideName2" value="Slide-2" />
    <input type="hidden" id="hdnSlideName3" value="Slide-3" />
    @if (mode == "Vertical")
    {
        <ul class="slides-ul">
            <li class="dnd-placeholder">
                <img src="~/images/Default_Slide_Image.jpeg" id="imageVertical1" class="menuboard-vertical-thum active_border" alt="Banner" onclick="SaveDesignBoardSlide(1); handleThumbClick(this);TabShowHide('In');updateEffectButtons('In');updateEffectButtons('Out');updateDirectionButtons('In');updateDirectionButtons('Out');">
                <div class="d-flex justify-content-center align-items-center gap-2">
                    <span>Slide-1</span>
                    <div class="slide-icon"><i class="fa-regular fa-clone" title="Duplicate" onclick="DuplicateSlide();"></i></div>
                    <div class="slide-icon delete"><i class="fa-regular fa-trash-can" title="Delete" onclick="DeleteSlide();"></i></div>
                    <div class="clear"></div>
                </div>
            </li>
            <li class="dnd-placeholder">
                <img src="~/images/Default_Slide_Image.jpeg" id="imageVertical2" class="menuboard-vertical-thum" alt="Banner" onclick="SaveDesignBoardSlide(2); handleThumbClick(this);TabShowHide('In');updateEffectButtons('In');updateEffectButtons('Out');updateDirectionButtons('In');updateDirectionButtons('Out');">
                <div class="d-flex justify-content-center align-items-center gap-2">
                    <span>Slide-2</span>
                    <div class="slide-icon"><i class="fa-regular fa-clone" title="Duplicate" onclick="DuplicateSlide();"></i></div>
                    <div class="slide-icon delete"><i class="fa-regular fa-trash-can" title="Delete" onclick="DeleteSlide();"></i></div>
                    <div class="clear"></div>
                </div>
            </li>
            <li class="dnd-placeholder">
                <img src="~/images/Default_Slide_Image.jpeg" id="imageVertical3" class="menuboard-vertical-thum" alt="Banner" onclick="SaveDesignBoardSlide(3); handleThumbClick(this);TabShowHide('In');updateEffectButtons('In');updateEffectButtons('Out');updateDirectionButtons('In');updateDirectionButtons('Out');">
                <div class="d-flex justify-content-center align-items-center gap-2">
                    <span>Slide-3</span>
                    <div class="slide-icon"><i class="fa-regular fa-clone" title="Duplicate" onclick="DuplicateSlide();"></i></div>
                    <div class="slide-icon delete"><i class="fa-regular fa-trash-can" title="Delete" onclick="DeleteSlide();"></i></div>
                    <div class="clear"></div>
                </div>
            </li>
        </ul>
    }
    else if (mode == "Horizontal")
    {
        <ul class="slides-ul">
            <li class="dnd-placeholder">
                <img src="~/images/Default_Slide_Image.jpeg" id="imageHorizontal1" class="menuboard-horizontal-thum active_border" alt="Banner" onclick="SaveDesignBoardSlide(1);handleVThumbClick(this);TabShowHide('In');updateEffectButtons('In');updateEffectButtons('Out');updateDirectionButtons('In');updateDirectionButtons('Out');">
                <div class="d-flex justify-content-center align-items-center gap-2">
                    <span>Slide-1</span>
                    <div class="slide-icon"><i class="fa-regular fa-clone" title="Duplicate" onclick="DuplicateSlide();"></i></div>
                    <div class="slide-icon delete"><i class="fa-regular fa-trash-can" title="Delete" onclick="DeleteSlide();"></i></div>
                    <div class="clear"></div>
                </div>
            </li>
            <li class="dnd-placeholder">
                <img src="~/images/Default_Slide_Image.jpeg" id="imageHorizontal2" class="menuboard-horizontal-thum" alt="Banner" onclick="SaveDesignBoardSlide(2);handleVThumbClick(this);TabShowHide('In');updateEffectButtons('In');updateEffectButtons('Out');updateDirectionButtons('In');updateDirectionButtons('Out');">
                <div class="d-flex justify-content-center align-items-center gap-2">
                    <span>Slide-2</span>
                    <div class="slide-icon"><i class="fa-regular fa-clone" title="Duplicate" onclick="DuplicateSlide();"></i></div>
                    <div class="slide-icon delete"><i class="fa-regular fa-trash-can" title="Delete" onclick="DeleteSlide();"></i></div>
                    <div class="clear"></div>
                </div>
            </li>
            <li class="dnd-placeholder">
                <img src="~/images/Default_Slide_Image.jpeg" id="imageHorizontal3" class="menuboard-horizontal-thum" alt="Banner" onclick="SaveDesignBoardSlide(3);handleVThumbClick(this);TabShowHide('In');updateEffectButtons('In');updateEffectButtons('Out');updateDirectionButtons('In');updateDirectionButtons('Out');">
                <div class="d-flex justify-content-center align-items-center gap-2">
                    <span>Slide-3</span>
                    <div class="slide-icon"><i class="fa-regular fa-clone" title="Duplicate" onclick="DuplicateSlide();"></i></div>
                    <div class="slide-icon delete"><i class="fa-regular fa-trash-can" title="Delete" onclick="DeleteSlide();"></i></div>
                    <div class="clear"></div>
                </div>
            </li>

        </ul>
    }
</div>

