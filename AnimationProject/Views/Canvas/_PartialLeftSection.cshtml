<script>
    (function () {
      // ensure the UL has the class so your CSS applies
      const ul = document.querySelector('.panel-left-scroll ul');
      if (ul && !ul.classList.contains('slides-ul')) ul.classList.add('slides-ul');

      // hand control to the global Sortable binder
      if (window.initSlidesDnD) window.initSlidesDnD();
    })();
</script>




<div class="panel-left-scroll">
    <button onclick="tranTogglePopup(); transitionSelected(this);" class="sd-btn-right mb-3"> <img src="~/images/icon-01.png" alt="Banner" style="width: 19px;">Transition</button>

