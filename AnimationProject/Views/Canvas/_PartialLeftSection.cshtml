@{
    Layout = null;
}
@{
    var mode = (string)(ViewBag.Orientation ?? "Unknown");
}
<style>

    /* Apply to the list no matter what */
    .panel-left-scroll ul.slides-ul {
        list-style: none;
        padding-left: 0;
        margin: 0;
    }

        .panel-left-scroll ul.slides-ul > li {
            cursor: grab;
        }

            .panel-left-scroll ul.slides-ul > li.dragging {
                opacity: 0.5;
            }

            /* Use a unique class to avoid Bootstrap's .placeholder conflicts */
            .panel-left-scroll ul.slides-ul > li.dnd-placeholder {
                outline: none !important;
                min-height: 48px; /* visible drop spot */
            }

        /* base card look */
        .panel-left-scroll ul.slides-ul > li {
            background: #fff; /* so the shadow looks clean */
            border-radius: 12px;
            transition: box-shadow .15s ease, transform .15s ease;
        }

            /* the item you grabbed */
            .panel-left-scroll ul.slides-ul > li.sortable-chosen {
                transform: scale(1.02);
            }

            /* the “ghost” that follows the pointer while dragging */
            .panel-left-scroll ul.slides-ul > li.sortable-ghost {
                box-shadow: 0 12px 28px rgba(0,0,0,.18), 0 8px 10px rgba(0,0,0,.12);
                opacity: 1; /* keep it fully visible */
                z-index: 1000; /* above neighbors */
                outline: none !important; /* kill any dashed outlines */
                border: none !important; /* just in case */
                background: #fff;
            }


</style>
