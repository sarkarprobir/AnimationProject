@{
    Layout = null;
}
@{
    var mode = (string)(ViewBag.Orientation ?? "Unknown");
}
<style>

    /* base card look */
    .panel-left-scroll ul.slides-ul > li {
        background: #fff;
        border-radius: 12px;
        transition: box-shadow .15s ease, transform .15s ease;
    }

        /* picked-up / dragging element */
        .panel-left-scroll ul.slides-ul > li.sortable-chosen,
        .panel-left-scroll ul.slides-ul > li.sortable-drag,
        .panel-left-scroll ul.slides-ul > li.slide-chosen,
        .panel-left-scroll ul.slides-ul > li.slide-drag {
            transform: scale(1.02);
            z-index: 3;
            box-shadow: 0 12px 28px rgba(0,0,0,.18), 0 8px 12px rgba(0,0,0,.12);
        }

        /* the “ghost/placeholder” following the cursor */
        .panel-left-scroll ul.slides-ul > li.sortable-ghost,
        .panel-left-scroll ul.slides-ul > li.slide-ghost {
            opacity: 1;
            background: #fff;
            z-index: 2;
            box-shadow: 0 8px 20px rgba(0,0,0,.14), 0 4px 8px rgba(0,0,0,.10);
            outline: none !important;
            border: none !important;
        }



</style>


