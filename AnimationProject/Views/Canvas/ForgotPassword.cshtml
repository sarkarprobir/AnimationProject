
@{
    Layout = null;
}
<link href="~/css/bootstrap.min.css" rel="stylesheet" />
<script src="~/js/bootstrap.bundle.min.js"></script>
<!-- Font Awesome -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css"
      rel="stylesheet" />
<!-- Google Font -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,100..900;1,100..900&family=Nunito+Sans:ital,opsz,wght@0,6..12,200..1000;1,6..12,200..1000&display=swap" rel="stylesheet">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&display=swap" rel="stylesheet">
<link href="~/css/Signup.css" rel="stylesheet" />

<div class="container-fluid login-From" id="signup_options" style="display:block; height: 100%">
    <div class="row">
        <div class="col-md-6 login-left" style="position: relative">
            <img src="~/images/laptop.png"
                 class="img-horizontal"
                 id="slide-img-2"
                 alt="horizental Menuboard"
                 title="horizental Menuboard"
            />
        </div>
        <div class="col-md-6 login-right">
            <div class="form-container">
                <form class="form">
                    <h2 class="form-title mb-3">
                        Forgot Password ?
                    </h2>
                    <div class="carousel">
                        <div class="inner">
                            <div class="sub-forms">
                                <div class="sub-form slide-1" id="slide-1">
                                    <p>Create your new password</p>
                                    
                                    <div class="form-floating1 mb-3">
                                        <input type="password"
                                               placeholder="Enter New Password"
                                               value=""
                                               id="password"
                                               class="form-control" />
                                        <i class="toggle-password fa fa-fw fa-eye-slash"></i>
                                    </div>
                                    <div class="form-floating1 mb-3">
                                        <input type="Password"
                                               placeholder="Confirm New Password"
                                               value=""
                                               id="password1"
                                               class="form-control" />
                                        <i class="toggle-password fa fa-fw fa-eye-slash"></i>
                                    </div>
                                    <button type="button"
                                            onclick="nextSlide('slide-1', 'slide-img-1', 'slide-img-2')"
                                            class="Continue-btn">
                                        Continue
                                    </button>
                                    <div class="form-floating mb-3">
                                        <p class="term-service">
                                            By clicking "Continue", your password will be reset.
                                        </p>
                                    </div>
                                </div>
 
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script src="~/js/bootstrap.bundle.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.3.1/jquery.min.js"></script>
<script id="rendered-js">
    $(".toggle-password").click(function () {
      $(this).toggleClass("fa-eye fa-eye-slash");
      input = $(this).parent().find("input");
      if (input.attr("type") == "password") {
        input.attr("type", "text");
      } else {
        input.attr("type", "password");
      }
    });
    
    function indusActive(event, clickedElement) {
      // Prevent default behavior (e.g., form submit, link follow)
      event.preventDefault();

      // Remove 'active_indus' from all elements
      document.querySelectorAll('.indus_btn').forEach(el => {
        el.classList.remove('active_indus');
      });

      // Add 'active_indus' to the clicked element
      clickedElement.classList.add('active_indus');
    }

</script>