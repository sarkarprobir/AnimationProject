<script>
    // $(document).ready(function(){
    //     LoadTemplates(0);
    //     LoadAllCategoryUseCase();
    // });
         $(document).ready(function () {
      const params = new URLSearchParams(window.location.search);
      const label = params.get("label");
      const idStr = params.get("id");
      const id = idStr && /^\d+$/.test(idStr) ? Number(idStr) : null;

      const cleanUrl = (baseURL || window.location.origin + "/") + "Canvas/Templates";

      if (label && id !== null) {
        // Use the params once, then replace the URL with clean form + state
        history.replaceState({ label, id }, "", cleanUrl);

        const headerEl = document.getElementById("templateHeader");
        if (headerEl) headerEl.textContent = label;
        LoadCategoryTemplate(id);
      } else if (history.state && Number.isFinite(history.state.id)) {
        const st = history.state;
        const headerEl = document.getElementById("templateHeader");
        if (headerEl) headerEl.textContent = st.label || "Templates";
        LoadCategoryTemplate(Number(st.id));
      } else {
        // default
        LoadTemplates(0);
      }

      // Always render the side/category grid
      LoadAllCategoryUseCase();
    });

</script>
