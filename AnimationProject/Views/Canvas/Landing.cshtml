                    <input type="password" id="passwordInput" class="input b_rad4" placeholder="Password" />
                    <button type="button" onclick="validateCredentials();" class="btn b_rad4">Log In</button>
                </div>
                <div class="d-flex justify-content-between">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" value="" id="checkDefault">
