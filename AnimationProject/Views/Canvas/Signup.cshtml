<div class="container-fluid login-From" id="signup_options" style="display:block; height: 100%">
    <div class="row">
        <div class="col-md-6 login-left" style="position: relative">
            <img src="~/images/watch.png"
                 class="img-vertical"
                 id="slide-img-1"
                 alt="Vertical Menuboard"
                 title="Vertical Menuboard" />
            <img src="~/images/laptop.png"
                 class="img-horizontal"
                 id="slide-img-2"
                 alt="horizental Menuboard"
                 title="horizental Menuboard"
                 style="display: none" />
        </div>
        <div class="col-md-6 login-right">
            <div class="form-container">
                <form class="form">
                    <h2 class="form-title mb-3" title="This is an animation soft">
                        AniBoard
                    </h2>
                    <div class="carousel">
                        <div class="inner">
                            <div class="sub-forms">
                                <div class="sub-form slide-1" id="slide-1">
                                    <p>Sign in to continue, or register for a new account.</p>
                                    <div class="form-floating1 mb-3">
                                        <input class="form-control"
                                               type="text"
                                               name="Email"
                                               id="firstName"
                                               placeholder="Email" />
                                    </div>
                                    <div class="form-floating1 mb-3">
                                        <input type="password"
                                               placeholder="Password"
                                               value=""
                                               id="password"
                                               class="form-control" />
                                        <i class="toggle-password fa fa-fw fa-eye-slash"></i>
                                    </div>
                                    <div class="form-floating1 mb-3">
                                        <input type="Password"
                                               placeholder="Confirm Password"
                                               value=""
                                               id="password1"
                                               class="form-control" />
                                        <i class="toggle-password fa fa-fw fa-eye-slash"></i>
                                    </div>
                                    <button type="button"
                                            onclick="nextSlide('slide-1', 'slide-img-1', 'slide-img-2')"
                                            class="Continue-btn">
                                        Continue
                                    </button>
                                    <div class="form-floating mb-3">
                                        <p class="term-service">
                                            By clicking "Continue", you agree to the
                                            <br /><a href="">Terms of Service</a>.
                                        </p>
                                    </div>
                                </div>

                                <div class="sub-form" id="slide-2">
                                    <p>
                                        Once you enter the code we sent to
                                        <a style="text-decoration: none; color: #6214fe"
                                           href="mailto:sarkarprobir@gmail.com">sarkarprobir@gmail.com</a>, you’ll be all logged in.
                                    </p>
                                    <div class="form-floating1 mb-3">
                                        <input class="form-control"
                                               type="text"
                                               name="Email"
                                               id="email"
                                               placeholder="Code" />
                                    </div>
                                    <button type="button"
                                            onclick="nextSlide('slide-2', 'slide-img-2', 'slide-img-1')"
                                            class="Continue-btn">
                                        Continue
                                    </button>
                                    <div class="form-floating mb-3">
                                        <p class="term-service">
                                            Didn’t get the code? <a href="#">Resend code</a>.
                                        </p>
                                    </div>
                                </div>
                                <div class="sub-form slide-3" id="slide-3">
                                    <p>Select Your Industry</p>
                                    <div class="d-flex gap-2 flex-wrap justify-content-center mb-4">
                                        <button onclick="indusActive(event, this);" class="indus_btn">Bank</button>
                                        <button onclick="indusActive(event, this);" class="indus_btn">Boutique</button>
                                        <button onclick="indusActive(event, this);" class="indus_btn">Corporate</button>
                                        <button onclick="indusActive(event, this);" class="indus_btn">Colleges</button>
                                        <button onclick="indusActive(event, this);" class="indus_btn">Car Repair</button>
                                        <button onclick="indusActive(event, this);" class="indus_btn">Entertainment</button>
                                        <button onclick="indusActive(event, this);" class="indus_btn">Hotels</button>
                                        <button onclick="indusActive(event, this);" class="indus_btn">Heathcare</button>
                                        <button onclick="indusActive(event, this);" class="indus_btn">Pet Shop</button>
                                        <button onclick="indusActive(event, this);" class="indus_btn">Retail</button>
                                        <button onclick="indusActive(event, this);" class="indus_btn">Resturant</button>
                                        <button onclick="indusActive(event, this);" class="indus_btn">Real Estate</button>
                                        <button onclick="indusActive(event, this);" class="indus_btn">Schools</button>
                                        <button onclick="indusActive(event, this);" class="indus_btn">Sports</button>
                                        <button onclick="indusActive(event, this);" class="indus_btn">Salon</button>
                                        <button onclick="indusActive(event, this);" class="indus_btn">Others</button>
                                    </div>
                                    <button onclick="finalClick();" type="button" class="Continue-btn">
                                        Continue
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
<div class="success_box" id="successBox" style="display: none;">
    <h2 class="success-title mb-3">
        AniBoard
    </h2>
    <div class="my-3">
        <img src="~/images/confetti.png" width="65px" alt="Alternate Text" />
    </div>
    <p class="success_p mb-5">Congratulation on joining! Your account is <br /> all set, and you're ready to explore!</p>
    <div class="d-flex gap-3 align-items-center">
        <a href="/Canvas/Templates" class="d-flex align-items-center success_btn s-select">Select Template From Gallery to Edit</a>
        <p class="success_p mb-0">OR</p>
        <button class="success_btn s-create" data-bs-toggle="modal" data-bs-target="#exampleModal">Create New AniBoard</button>
    </div>
</div>

<!-- Modal Structure -->
<div class="modal fade layout_modal" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content p-3">
            <div class="modal-header">
                <h5 class="modal-title" id="aniBoardModalLabel">New AniBoard</h5>
            </div>

            <div class="modal-body">
                <!-- Vertical Option -->
                <div class="option-box d-flex justify-content-between align-items-center mb-2" id="vertical-option">
                    <div class="d-flex align-items-center">
                        <div class="portrait-icon"></div>
                        <span class="vertical_option">Vertical / Portrait</span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span>1080x1920</span>
                        <span class="checkmark"></span>
                    </div>
                </div>

                <!-- Horizontal Option -->
                <div class="option-box d-flex justify-content-between align-items-center" id="horizontal-option">
                    <div class="d-flex align-items-center">
                        <div class="landscape-icon"></div>
                        <span>Horizontal / Landscape</span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span>1920x1080</span>
                        <span class="checkmark"></span>
                    </div>
                </div>
            </div>

            <div class="modal-footer pt-0">
                <button type="button" class="cancel-btn" data-bs-dismiss="modal">Cancel</button>
                <button class="create-btn" id="create-button">Create</button>
            </div>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.9.3/dist/confetti.browser.min.js"></script>

<script>
    function nextSlide(param, param_img, param_img2) {
      document.getElementById(param).style.display = "none";
      document.getElementById(param_img).style.display = "none";
      document.getElementById(param_img2).style.display = "block";
    }

    function finalClick() {
        document.getElementById("signup_options").style.display = "none";
        document.getElementById("successBox").style.display = "flex";

        // 🎉 Confetti Celebration
        var duration = 3 * 1000; // 3 seconds
        var end = Date.now() + duration;

        (function frame() {
            confetti({
                particleCount: 5,
                angle: 60,
                spread: 55,
                origin: { x: 0 }
            });
            confetti({
                particleCount: 5,
                angle: 120,
                spread: 55,
                origin: { x: 1 }
            });

            if (Date.now() < end) {
                requestAnimationFrame(frame);
            }
        })();
    }

